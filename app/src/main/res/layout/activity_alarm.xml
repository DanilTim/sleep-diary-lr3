<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Шапка -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="← Назад"
                android:backgroundTint="#333333"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:layout_marginEnd="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⏰ Умный будильник"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Время отхода ко сну -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🌙 Время отхода ко сну"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <TimePicker
            android:id="@+id/timePickerSleep"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:theme="@style/WhiteTimePicker"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Разделитель -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#333333"
            android:layout_marginBottom="16dp" />

        <!-- Время пробуждения -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️ Время пробуждения"
            android:textColor="#AAAAAA"
            android:textSize="15sp"
            android:layout_marginBottom="4dp" />

        <TimePicker
            android:id="@+id/timePickerWake"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:timePickerMode="spinner"
            android:theme="@style/WhiteTimePicker"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp" />

        <!-- Статус -->
        <TextView
            android:id="@+id/tvAlarmStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="❌ Будильник не установлен"
            android:textColor="#AAAAAA"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Кнопки -->
        <Button
            android:id="@+id/btnSetAlarm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="✅  Установить будильник"
            android:backgroundTint="#1B5E20"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/btnCancelAlarm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="❌  Отключить будильник"
            android:backgroundTint="#B71C1C"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>